# ==============================================================================
# CODELENS BACKEND CONFIGURATION EXAMPLE
# ==============================================================================

# Application Environment
PROJECT_NAME="CodeLens"
VERSION="1.0.0"
DEBUG=True

# Security (JWT secret key)
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite (Default): sqlite+aiosqlite:///./codelens.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/CodeLens
DATABASE_URL="sqlite+aiosqlite:///./codelens.db"

# ==============================================================================
# AI LLM API KEYS (OPTIONAL)
# If left blank, CodeLens uses its built-in deterministic pedagogical rule engine.
# ==============================================================================
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
